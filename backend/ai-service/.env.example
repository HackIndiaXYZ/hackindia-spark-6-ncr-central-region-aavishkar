## JanSetu AI Service (backend/ai-service)
## Copy to ".env" and fill real values.

# MongoDB connection
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=jansetu

# LLM key (used as OpenAI API key in main.py)
EMERGENT_LLM_KEY=your_openai_or_emergent_key_here

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256

# Optional: OpenAI model name
OPENAI_MODEL=gpt-3.5-turbo

# ---------------------------------------------------------------
# JanSetu AI Service — Environment Variables
# ---------------------------------------------------------------

# Your OpenAI API key — REQUIRED for GPT-powered letter drafting.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=replace-with-your-openai-api-key
# Model to use for letter generation.
# Recommended: gpt-3.5-turbo (fast + cheap) or gpt-4o (higher quality)
OPENAI_MODEL=gpt-3.5-turbo
